{
  "expo": {
    "name": "Nucleus Education",
    "slug": "nucleus-education",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nucleus-education",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nucleus.education"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nucleus.education"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "updates",
          "color": "#7c3aed"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-video",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "28fa168d-6fd2-4b1c-bf1c-451ccf3f8302",
        "firebase": {
          "serverKey": "YOUR_FCM_SERVER_KEY",
          "senderId": "YOUR_FCM_SENDER_ID"
        }
      }
    },
    "owner": "federicq"
  }
}
