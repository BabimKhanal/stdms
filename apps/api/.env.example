# Copy to .env and adjust.

# --- Database -----------------------------------------------------------
# Owner account: used only for migrations + seeding.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edu_platform
# Runtime account (non-owner): Row Level Security is genuinely enforced
# because this role does not own the tables.
APP_DATABASE_URL=postgres://edu_app:edu_app_secret@localhost:5432/edu_platform

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# --- Server -------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Cloudinary uploads --------------------------------------------------
# Keep the API secret on the server. The web/mobile clients only receive
# short-lived signatures from POST /api/v1/uploads/sign.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Outbound notifications -----------------------------------------------
# Use resend in production. Console prints messages without delivering them.
# console | resend | sendgrid | mailgun | smtp
MAILER_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Required to encrypt tenant-specific provider credentials. Use a random 32+ character secret.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=
MAIL_FROM=Nucleus <no-reply@example.com>
MAIL_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_URL=http://localhost:3000/reset-password
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
PUSH_PROVIDER=console
PUSH_WEBHOOK_URL=
EXPO_ACCESS_TOKEN=

# --- Production render.yaml dashboard values -------------------------------
# The following must be set in the Render dashboard (sync: false in render.yaml).
# Do NOT commit real secrets here.
# MAILER_PROVIDER=resend            # console | resend | sendgrid | mailgun | smtp
# RESEND_API_KEY=re_...
# PASSWORD_RESET_URL=https://<web-app>.onrender.com/reset-password
# EMAIL_CREDENTIALS_ENCRYPTION_KEY=<random 32+ char secret>
# ESEWA_ENABLED=false               # set "true" only with production credentials below
# ESEWA_MERCHANT_CODE=<production merchant code>
# ESEWA_SECRET_KEY=<production eSewa secret>
# PAYMENT_CALLBACK_URL=https://<api>.onrender.com/api/v1/payments/esewa

# --- eSewa hosted checkout (local defaults) --------------------------------
ESEWA_ENABLED=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
PAYMENT_CALLBACK_URL=http://localhost:4000/api/v1/payments/esewa

# --- Database backups (scheduled runner only) ------------------------------
# Use a direct PostgreSQL connection (not a Neon pooled URL) for pg_dump.
# Set these secrets on the Render Cron service, not on the API service.
# BACKUP_DATABASE_URL=
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=<base64-encoded 32-byte key; preserve for restore>
# BACKUP_ALERT_WEBHOOK_URL=
# BACKUP_RETENTION_DAILY=35
# BACKUP_RETENTION_MONTHLY=12
