{
  "name": "education-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "npm run db:generate -w @edu/api",
    "db:migrate": "npm run db:migrate -w @edu/api",
    "db:backup": "npm run db:backup -w @edu/api",
    "db:backup:check": "npm run db:backup:check -w @edu/api",
    "db:seed": "npm run db:seed -w @edu/api",
    "db:setup": "npm run db:setup -w @edu/api"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}
